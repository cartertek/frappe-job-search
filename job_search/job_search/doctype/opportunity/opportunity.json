{
  "doctype": "DocType",
  "name": "Opportunity",
  "module": "Job Search",
  "custom": 0,
  "istable": 0,
  "engine": "InnoDB",
  "autoname": "hash",
  "track_changes": 1,
  "field_order": [
    "overview_section",
    "overview_column",
    "status",
    "organization",
    "opportunity_name",
    "jobs",
    "active_job_search",
    "eligibility_status",
    "rejection_scope",
    "rejection_search",
    "rejection_reason",
    "metadata_column",
    "priority",
    "discovered_on",
    "deadline",
    "applied_on",
    "next_action_on",
    "closure_reason",
    "offer_details",
    "last_decision",
    "last_decision_record",
    "latest_application",
    "interview_schedule",
    "globally_rejected",
    "research_notes_section",
    "research_findings",
    "research_recommendation",
    "application_materials_for_review",
    "interview_preparation",
    "human_feedback_and_instructions"
  ],
  "fields": [
    {
      "fieldname": "overview_section",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "overview_column",
      "fieldtype": "Column Break",
      "label": "Overview"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Discovered\nResearching\nReady to Review\nQualified\nApplied\nInterviewing\nAccepted\nRejected",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "read_only": 1
    },
    {
      "fieldname": "organization",
      "fieldtype": "Link",
      "options": "Job Search Employer",
      "label": "Employer",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "opportunity_name",
      "label": "Opportunity Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "jobs",
      "label": "Jobs",
      "fieldtype": "Table",
      "options": "Opportunity Job",
      "description": "Jobs supporting this hiring opportunity; one job may be linked to multiple opportunities."
    },
    {
      "fieldname": "active_job_search",
      "label": "Active Job Search",
      "fieldtype": "Link",
      "options": "Job Search Search",
      "description": "Search whose filters and research heuristics must be complete before Ready to Review."
    },
    {
      "fieldname": "eligibility_status",
      "label": "Current Eligibility",
      "fieldtype": "Select",
      "options": "Unverified\nEligible\nNeeds Research",
      "default": "Unverified",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "rejection_scope",
      "fieldtype": "Select",
      "label": "Rejection Scope",
      "options": "\nSearch Only\nOpportunity Globally\nEntire Organization",
      "depends_on": "eval:!!doc.rejection_scope || doc.status==\"Rejected\""
    },
    {
      "fieldname": "rejection_search",
      "fieldtype": "Link",
      "options": "Job Search Search",
      "label": "Rejected From Search",
      "read_only": 1,
      "depends_on": "eval:doc.rejection_scope==\"Search Only\""
    },
    {
      "fieldname": "rejection_reason",
      "fieldtype": "Small Text",
      "label": "Rejection Reason",
      "depends_on": "eval:!!doc.rejection_scope || doc.status==\"Rejected\""
    },
    {
      "fieldname": "metadata_column",
      "fieldtype": "Column Break",
      "label": "Metadata"
    },
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Select",
      "options": "\nLow\nMedium\nHigh\nCritical"
    },
    {
      "fieldname": "discovered_on",
      "label": "Discovered On",
      "fieldtype": "Date"
    },
    {
      "fieldname": "deadline",
      "label": "Deadline",
      "fieldtype": "Date"
    },
    {
      "fieldname": "applied_on",
      "label": "Applied On",
      "fieldtype": "Date"
    },
    {
      "fieldname": "next_action_on",
      "label": "Next Action On",
      "fieldtype": "Date"
    },
    {
      "fieldname": "closure_reason",
      "label": "Closure Reason",
      "fieldtype": "Small Text",
      "depends_on": "eval:doc.status!=\"Rejected\""
    },
    {
      "fieldname": "offer_details",
      "label": "Offer Details",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "last_decision",
      "label": "Last Human Decision",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "last_decision_record",
      "label": "Latest Decision Record",
      "fieldtype": "Link",
      "options": "Job Search Decision",
      "read_only": 1
    },
    {
      "fieldname": "latest_application",
      "label": "Latest Application Record",
      "fieldtype": "Link",
      "options": "Job Search Application",
      "read_only": 1
    },
    {
      "fieldname": "interview_schedule",
      "label": "Interview Schedule",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "globally_rejected",
      "label": "Opportunity Rejected Globally",
      "fieldtype": "Check",
      "default": "0",
      "in_list_view": 1
    },
    {
      "fieldname": "research_notes_section",
      "fieldtype": "Section Break",
      "label": "Research Notes",
      "collapsible": 1
    },
    {
      "fieldname": "research_findings",
      "label": "Research Findings & Sources",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "research_recommendation",
      "label": "Agent Recommendation",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "application_materials_for_review",
      "label": "Application Materials for Review",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "interview_preparation",
      "label": "Interview Preparation",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "human_feedback_and_instructions",
      "label": "Human Feedback / Instructions",
      "fieldtype": "Text Editor"
    }
  ],
  "permissions": [
    {
      "role": "Job Search Operator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Job Search Approver",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "actions": [],
  "title_field": "opportunity_name",
  "show_title_field_in_link": 1
}
