{
  "doctype": "DocType",
  "name": "Job Search Search",
  "module": "Job Search",
  "custom": 0,
  "istable": 0,
  "engine": "InnoDB",
  "autoname": "hash",
  "track_changes": 1,
  "field_order": [
    "search_name",
    "enabled",
    "title_matches",
    "location_match",
    "employment_type",
    "work_arrangement",
    "seniority",
    "salary_min",
    "currency",
    "compensation_period",
    "posted_after",
    "heuristics",
    "require_heuristics",
    "overrides"
  ],
  "fields": [
    {
      "fieldname": "search_name",
      "label": "Search Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "enabled",
      "label": "Enabled",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "title_matches",
      "label": "Job Titles to Match",
      "fieldtype": "Small Text",
      "description": "One complete job title per line. A job matches if its title equals any line (case-insensitive)."
    },
    {
      "fieldname": "location_match",
      "label": "Location to Match",
      "fieldtype": "Data",
      "description": "Match the complete job location, ignoring case and surrounding whitespace."
    },
    {
      "fieldname": "employment_type",
      "label": "Employment Type",
      "fieldtype": "Select",
      "options": "\nFull Time\nPart Time\nContract\nTemporary\nInternship"
    },
    {
      "fieldname": "work_arrangement",
      "label": "Work Arrangement",
      "fieldtype": "Select",
      "options": "\nRemote\nHybrid\nOn Site"
    },
    {
      "fieldname": "seniority",
      "label": "Seniority",
      "fieldtype": "Select",
      "options": "\nJunior\nMid\nSenior\nStaff\nPrincipal\nLead\nManager\nDirector\nExecutive"
    },
    {
      "fieldname": "salary_min",
      "label": "Minimum Compensation",
      "fieldtype": "Currency"
    },
    {
      "fieldname": "currency",
      "label": "Currency",
      "fieldtype": "Link",
      "options": "Currency"
    },
    {
      "fieldname": "compensation_period",
      "label": "Compensation Period",
      "fieldtype": "Select",
      "options": "\nYear\nMonth\nHour\nProject"
    },
    {
      "fieldname": "posted_after",
      "label": "Posted On Or After",
      "fieldtype": "Date"
    },
    {
      "fieldname": "heuristics",
      "label": "Research Heuristics",
      "fieldtype": "Table",
      "description": "Subjective research criteria. Each row has a name and a description; these instructions are evaluated by the researcher, not by deterministic filters.",
      "options": "Job Search Heuristic"
    },
    {
      "fieldname": "require_heuristics",
      "label": "Require Explicit Heuristic Approval",
      "fieldtype": "Check",
      "description": "Only explicitly included jobs appear in this search."
    },
    {
      "fieldname": "overrides",
      "label": "Explicit Job Overrides",
      "fieldtype": "Table",
      "options": "Job Search Membership"
    }
  ],
  "permissions": [
    {
      "role": "Job Search Operator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Job Search Approver",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "actions": [],
  "title_field": "search_name",
  "show_title_field_in_link": 1
}
