{
  "doctype": "DocType",
  "name": "Job Search Employer",
  "module": "Job Search",
  "custom": 0,
  "istable": 0,
  "engine": "InnoDB",
  "autoname": "hash",
  "track_changes": 1,
  "field_order": [
    "organization_name",
    "careers_url",
    "employer_category",
    "employer_priority",
    "research_status",
    "last_researched",
    "employment_notes",
    "globally_rejected"
  ],
  "fields": [
    {
      "fieldname": "organization_name",
      "fieldtype": "Data",
      "label": "Employer Name",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "careers_url",
      "label": "Careers URL",
      "fieldtype": "Data",
      "options": "URL"
    },
    {
      "fieldname": "employer_category",
      "label": "Employer Category",
      "fieldtype": "Select",
      "options": "\nStartup\nEnterprise\nNonprofit\nAgency\nGovernment\nOther"
    },
    {
      "fieldname": "employer_priority",
      "label": "Employer Priority",
      "fieldtype": "Select",
      "options": "\nLow\nMedium\nHigh"
    },
    {
      "fieldname": "research_status",
      "label": "Research Status",
      "fieldtype": "Select",
      "options": "\nNot Started\nIn Progress\nComplete\nStale"
    },
    {
      "fieldname": "last_researched",
      "label": "Last Researched",
      "fieldtype": "Date"
    },
    {
      "fieldname": "employment_notes",
      "label": "Employment Notes",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "globally_rejected",
      "label": "Rejected From All Searches",
      "fieldtype": "Check",
      "default": "0",
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "Job Search Operator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Job Search Approver",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "actions": [],
  "title_field": "organization_name",
  "show_title_field_in_link": 1
}
