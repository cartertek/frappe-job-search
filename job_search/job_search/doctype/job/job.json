{
  "doctype": "DocType",
  "name": "Job",
  "module": "Job Search",
  "custom": 0,
  "istable": 0,
  "engine": "InnoDB",
  "autoname": "hash",
  "track_changes": 1,
  "field_order": [
    "overview_section",
    "overview_column",
    "organization",
    "job_title",
    "metadata_column",
    "availability_status",
    "job_rejection_reason",
    "posting_url",
    "requisition_id",
    "discovered_on",
    "latest_posting",
    "search_fields_section",
    "active_job_search",
    "location",
    "employment_type",
    "work_arrangement",
    "seniority",
    "search_compensation_column",
    "compensation_not_given",
    "compensation_min",
    "compensation_max",
    "currency",
    "compensation_period",
    "posted_on",
    "last_active_on",
    "last_active_source_url",
    "job_details_section",
    "job_description",
    "research_heuristics_section",
    "research_heuristics"
  ],
  "fields": [
    {
      "fieldname": "overview_section",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "overview_column",
      "fieldtype": "Column Break",
      "label": "Overview"
    },
    {
      "fieldname": "organization",
      "fieldtype": "Link",
      "options": "Job Search Employer",
      "label": "Employer",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "job_title",
      "label": "Job Title",
      "fieldtype": "Data",
      "reqd": 0
    },
    {
      "fieldname": "metadata_column",
      "fieldtype": "Column Break",
      "label": "Metadata"
    },
    {
      "fieldname": "availability_status",
      "label": "Availability",
      "fieldtype": "Select",
      "options": "Unknown\nActive\nClosed\nRejected",
      "default": "Unknown",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "description": "Availability and independent Job rejection only; not Opportunity pursuit status."
    },
    {
      "fieldname": "job_rejection_reason",
      "label": "Job Rejection Reason",
      "fieldtype": "Small Text",
      "depends_on": "eval:doc.availability_status==\"Rejected\""
    },
    {
      "fieldname": "posting_url",
      "label": "Job Posting URL",
      "fieldtype": "Data",
      "options": "URL"
    },
    {
      "fieldname": "requisition_id",
      "label": "Requisition ID",
      "fieldtype": "Data"
    },
    {
      "fieldname": "discovered_on",
      "label": "Discovered On",
      "fieldtype": "Date"
    },
    {
      "fieldname": "latest_posting",
      "label": "Job Posting",
      "fieldtype": "Link",
      "options": "Job Search Posting",
      "read_only": 1
    },
    {
      "fieldname": "search_fields_section",
      "fieldtype": "Section Break",
      "label": "Job Search Fields"
    },
    {
      "fieldname": "active_job_search",
      "fieldtype": "Link",
      "options": "Job Search Search",
      "label": "Original Discovery Search",
      "description": "Historical discovery source. Opportunities can match multiple searches independently."
    },
    {
      "fieldname": "location",
      "label": "Location",
      "fieldtype": "Data"
    },
    {
      "fieldname": "employment_type",
      "label": "Employment Type",
      "fieldtype": "Select",
      "options": "\nFull Time\nPart Time\nContract\nTemporary\nInternship"
    },
    {
      "fieldname": "work_arrangement",
      "label": "Work Arrangement",
      "fieldtype": "Select",
      "options": "\nRemote\nHybrid\nOn Site"
    },
    {
      "fieldname": "seniority",
      "label": "Seniority",
      "fieldtype": "Select",
      "options": "\nJunior\nMid\nSenior\nStaff\nPrincipal\nLead\nManager\nDirector\nExecutive"
    },
    {
      "fieldname": "search_compensation_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "compensation_not_given",
      "label": "Compensation Not Given",
      "fieldtype": "Check",
      "description": "Check when the posting does not state compensation. Compensation fields are cleared."
    },
    {
      "fieldname": "compensation_min",
      "label": "Compensation Min",
      "fieldtype": "Currency",
      "options": "currency",
      "read_only_depends_on": "eval:doc.compensation_not_given"
    },
    {
      "fieldname": "compensation_max",
      "label": "Compensation Max",
      "fieldtype": "Currency",
      "options": "currency",
      "read_only_depends_on": "eval:doc.compensation_not_given"
    },
    {
      "fieldname": "currency",
      "label": "Currency",
      "fieldtype": "Link",
      "options": "Currency",
      "read_only_depends_on": "eval:doc.compensation_not_given"
    },
    {
      "fieldname": "compensation_period",
      "label": "Compensation Period",
      "fieldtype": "Select",
      "options": "\nYear\nMonth\nHour\nProject",
      "read_only_depends_on": "eval:doc.compensation_not_given"
    },
    {
      "fieldname": "posted_on",
      "label": "Posted On",
      "fieldtype": "Date"
    },
    {
      "fieldname": "last_active_on",
      "label": "Last Active Date",
      "fieldtype": "Date",
      "description": "Most recent date supported by evidence of active recruiting for this exact opening. Original posting date is recorded separately."
    },
    {
      "fieldname": "last_active_source_url",
      "label": "Last Active Evidence URL",
      "fieldtype": "Data",
      "options": "URL",
      "description": "Source establishing active recruiting for this opening on the Last Active Date."
    },
    {
      "fieldname": "job_details_section",
      "fieldtype": "Section Break",
      "label": "Job Details"
    },
    {
      "fieldname": "job_description",
      "label": "Job Description",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "research_heuristics_section",
      "fieldtype": "Section Break",
      "label": "Heuristic Claims"
    },
    {
      "fieldname": "research_heuristics",
      "fieldtype": "Table",
      "label": "Heuristic Claims",
      "options": "Job Search Heuristic Value",
      "description": "Each claim must identify a heuristic, provide an exact verbatim quote and a source URL containing the quote. Multiple claims per heuristic are allowed."
    }
  ],
  "permissions": [
    {
      "role": "Job Search Operator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Job Search Approver",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "actions": [],
  "title_field": "job_title",
  "show_title_field_in_link": 1
}
