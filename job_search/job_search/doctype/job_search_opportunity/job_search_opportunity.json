{
  "doctype": "DocType",
  "name": "Job Search Opportunity",
  "module": "Job Search",
  "custom": 0,
  "istable": 0,
  "engine": "InnoDB",
  "autoname": "hash",
  "track_changes": 1,
  "field_order": [
    "status",
    "organization",
    "deal_owner",
    "job_title",
    "posting_url",
    "requisition_id",
    "employment_type",
    "work_arrangement",
    "location",
    "compensation_min",
    "compensation_max",
    "currency",
    "compensation_period",
    "seniority",
    "discovered_on",
    "posted_on",
    "deadline",
    "qualification",
    "qualification_rationale",
    "applied_on",
    "next_action_on",
    "priority",
    "closure_reason",
    "offer_details",
    "posting_digest",
    "research_digest",
    "agent_recommendation",
    "application_review",
    "interview_brief",
    "human_feedback",
    "human_action",
    "human_action_rationale",
    "review_request",
    "review_status",
    "review_assigned_to",
    "review_task",
    "posting_text",
    "latest_posting",
    "last_decision",
    "last_decision_record",
    "latest_application",
    "interview_schedule",
    "review_assignment",
    "globally_rejected"
  ],
  "fields": [
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Discovered\nResearching\nQualified\nPreparing\nApplied\nScreening\nInterviewing\nOffer\nAccepted\nRejected\nWithdrawn\nClosed",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "organization",
      "fieldtype": "Link",
      "options": "Job Search Employer",
      "label": "Employer",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "deal_owner",
      "fieldtype": "Link",
      "options": "User",
      "label": "Owner"
    },
    {
      "fieldname": "job_title",
      "label": "Job Title",
      "fieldtype": "Data",
      "reqd": 0
    },
    {
      "fieldname": "posting_url",
      "label": "Job Posting URL",
      "fieldtype": "Data",
      "options": "URL"
    },
    {
      "fieldname": "requisition_id",
      "label": "Requisition ID",
      "fieldtype": "Data"
    },
    {
      "fieldname": "employment_type",
      "label": "Employment Type",
      "fieldtype": "Select",
      "options": "\nFull Time\nPart Time\nContract\nTemporary\nInternship"
    },
    {
      "fieldname": "work_arrangement",
      "label": "Work Arrangement",
      "fieldtype": "Select",
      "options": "\nRemote\nHybrid\nOn Site"
    },
    {
      "fieldname": "location",
      "label": "Location",
      "fieldtype": "Data"
    },
    {
      "fieldname": "compensation_min",
      "label": "Compensation Min",
      "fieldtype": "Currency",
      "options": "currency"
    },
    {
      "fieldname": "compensation_max",
      "label": "Compensation Max",
      "fieldtype": "Currency",
      "options": "currency"
    },
    {
      "fieldname": "currency",
      "label": "Currency",
      "fieldtype": "Link",
      "options": "Currency"
    },
    {
      "fieldname": "compensation_period",
      "label": "Compensation Period",
      "fieldtype": "Select",
      "options": "\nYear\nMonth\nHour\nProject"
    },
    {
      "fieldname": "seniority",
      "label": "Seniority",
      "fieldtype": "Select",
      "options": "\nJunior\nMid\nSenior\nStaff\nPrincipal\nLead\nManager\nDirector\nExecutive"
    },
    {
      "fieldname": "discovered_on",
      "label": "Discovered On",
      "fieldtype": "Date"
    },
    {
      "fieldname": "posted_on",
      "label": "Posted On",
      "fieldtype": "Date"
    },
    {
      "fieldname": "deadline",
      "label": "Deadline",
      "fieldtype": "Date"
    },
    {
      "fieldname": "qualification",
      "label": "Qualification",
      "fieldtype": "Select",
      "options": "\nUndecided\nPursue\nHold\nReject"
    },
    {
      "fieldname": "qualification_rationale",
      "label": "Qualification Rationale",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "applied_on",
      "label": "Applied On",
      "fieldtype": "Date"
    },
    {
      "fieldname": "next_action_on",
      "label": "Next Action On",
      "fieldtype": "Date"
    },
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Select",
      "options": "\nLow\nMedium\nHigh\nCritical"
    },
    {
      "fieldname": "closure_reason",
      "label": "Closure Reason",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "offer_details",
      "label": "Offer Details",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "posting_digest",
      "label": "Job Description / Posting",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "research_digest",
      "label": "Research Findings & Sources",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "agent_recommendation",
      "label": "Agent Recommendation",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "application_review",
      "label": "Application Materials for Review",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "interview_brief",
      "label": "Interview Preparation",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "human_feedback",
      "label": "Human Feedback / Instructions",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "human_action",
      "label": "Record Human Decision",
      "fieldtype": "Select",
      "options": "\nPursue\nDecline\nAuthorize Application\nDecline Application\nAccept Offer\nReject Offer\nWithdraw\nOverride",
      "hidden": 1
    },
    {
      "fieldname": "human_action_rationale",
      "label": "Decision Rationale",
      "fieldtype": "Small Text",
      "hidden": 1
    },
    {
      "fieldname": "review_request",
      "label": "Human Review Requested",
      "fieldtype": "Data"
    },
    {
      "fieldname": "review_status",
      "label": "Review",
      "fieldtype": "Select",
      "options": "\nPending\nCompleted"
    },
    {
      "fieldname": "review_assigned_to",
      "label": "Human Reviewer",
      "fieldtype": "Link",
      "options": "User"
    },
    {
      "fieldname": "review_task",
      "label": "Review Task",
      "fieldtype": "Link",
      "options": "Job Search Task",
      "read_only": 1
    },
    {
      "fieldname": "posting_text",
      "label": "Captured Job Posting",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "latest_posting",
      "label": "Latest Posting Revision",
      "fieldtype": "Link",
      "options": "Job Search Posting",
      "read_only": 1
    },
    {
      "fieldname": "last_decision",
      "label": "Last Human Decision",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "last_decision_record",
      "label": "Latest Decision Record",
      "fieldtype": "Link",
      "options": "Job Search Decision",
      "read_only": 1
    },
    {
      "fieldname": "latest_application",
      "label": "Latest Application Record",
      "fieldtype": "Link",
      "options": "Job Search Application",
      "read_only": 1
    },
    {
      "fieldname": "interview_schedule",
      "label": "Interview Schedule",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "review_assignment",
      "label": "Review Assignment",
      "fieldtype": "Link",
      "options": "ToDo",
      "read_only": 1
    },
    {
      "fieldname": "globally_rejected",
      "label": "Rejected From All Searches",
      "fieldtype": "Check",
      "default": "0",
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "Job Search Operator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Job Search Approver",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "actions": [],
  "title_field": "job_title",
  "show_title_field_in_link": 1
}
