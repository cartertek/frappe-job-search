{
  "doctype": "DocType",
  "name": "Job Search Opportunity",
  "module": "Job Search",
  "custom": 0,
  "istable": 0,
  "engine": "InnoDB",
  "autoname": "hash",
  "track_changes": 1,
  "field_order": [
    "overview_section",
    "overview_column",
    "status",
    "organization",
    "job_title",
    "metadata_column",
    "posting_url",
    "requisition_id",
    "priority",
    "discovered_on",
    "deadline",
    "applied_on",
    "next_action_on",
    "closure_reason",
    "offer_details",
    "latest_posting",
    "last_decision",
    "last_decision_record",
    "latest_application",
    "interview_schedule",
    "globally_rejected",
    "search_fields_section",
    "active_job_search",
    "location",
    "employment_type",
    "work_arrangement",
    "seniority",
    "search_compensation_column",
    "compensation_not_given",
    "compensation_min",
    "compensation_max",
    "currency",
    "compensation_period",
    "posted_on",
    "job_details_section",
    "posting_digest",
    "research_heuristics_section",
    "research_heuristics",
    "research_notes_section",
    "research_digest",
    "agent_recommendation",
    "application_review",
    "interview_brief",
    "human_feedback"
  ],
  "fields": [
    {
      "fieldname": "overview_section",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "overview_column",
      "fieldtype": "Column Break",
      "label": "Overview"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Discovered\nResearching\nReady to Review\nQualified\nApplied\nInterviewing\nAccepted\nRejected",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "read_only": 1
    },
    {
      "fieldname": "organization",
      "fieldtype": "Link",
      "options": "Job Search Employer",
      "label": "Employer",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "job_title",
      "label": "Job Title",
      "fieldtype": "Data",
      "reqd": 0
    },
    {
      "fieldname": "metadata_column",
      "fieldtype": "Column Break",
      "label": "Metadata"
    },
    {
      "fieldname": "posting_url",
      "label": "Job Posting URL",
      "fieldtype": "Data",
      "options": "URL"
    },
    {
      "fieldname": "requisition_id",
      "label": "Requisition ID",
      "fieldtype": "Data"
    },
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Select",
      "options": "\nLow\nMedium\nHigh\nCritical"
    },
    {
      "fieldname": "discovered_on",
      "label": "Discovered On",
      "fieldtype": "Date"
    },
    {
      "fieldname": "deadline",
      "label": "Deadline",
      "fieldtype": "Date"
    },
    {
      "fieldname": "applied_on",
      "label": "Applied On",
      "fieldtype": "Date"
    },
    {
      "fieldname": "next_action_on",
      "label": "Next Action On",
      "fieldtype": "Date"
    },
    {
      "fieldname": "closure_reason",
      "label": "Closure Reason",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "offer_details",
      "label": "Offer Details",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "latest_posting",
      "label": "Job Posting",
      "fieldtype": "Link",
      "options": "Job Search Posting",
      "read_only": 1
    },
    {
      "fieldname": "last_decision",
      "label": "Last Human Decision",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "last_decision_record",
      "label": "Latest Decision Record",
      "fieldtype": "Link",
      "options": "Job Search Decision",
      "read_only": 1
    },
    {
      "fieldname": "latest_application",
      "label": "Latest Application Record",
      "fieldtype": "Link",
      "options": "Job Search Application",
      "read_only": 1
    },
    {
      "fieldname": "interview_schedule",
      "label": "Interview Schedule",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "globally_rejected",
      "label": "Rejected From All Searches",
      "fieldtype": "Check",
      "default": "0",
      "in_list_view": 1
    },
    {
      "fieldname": "search_fields_section",
      "fieldtype": "Section Break",
      "label": "Job Search Fields"
    },
    {
      "fieldname": "active_job_search",
      "fieldtype": "Link",
      "options": "Job Search Search",
      "label": "Active Job Search",
      "description": "Search whose filters and research heuristics must be complete before Ready to Review."
    },
    {
      "fieldname": "location",
      "label": "Location",
      "fieldtype": "Data"
    },
    {
      "fieldname": "employment_type",
      "label": "Employment Type",
      "fieldtype": "Select",
      "options": "\nFull Time\nPart Time\nContract\nTemporary\nInternship"
    },
    {
      "fieldname": "work_arrangement",
      "label": "Work Arrangement",
      "fieldtype": "Select",
      "options": "\nRemote\nHybrid\nOn Site"
    },
    {
      "fieldname": "seniority",
      "label": "Seniority",
      "fieldtype": "Select",
      "options": "\nJunior\nMid\nSenior\nStaff\nPrincipal\nLead\nManager\nDirector\nExecutive"
    },
    {
      "fieldname": "search_compensation_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "compensation_not_given",
      "label": "Compensation Not Given",
      "fieldtype": "Check",
      "description": "Check when the posting does not state compensation. Compensation fields are cleared."
    },
    {
      "fieldname": "compensation_min",
      "label": "Compensation Min",
      "fieldtype": "Currency",
      "options": "currency",
      "read_only_depends_on": "eval:doc.compensation_not_given"
    },
    {
      "fieldname": "compensation_max",
      "label": "Compensation Max",
      "fieldtype": "Currency",
      "options": "currency",
      "read_only_depends_on": "eval:doc.compensation_not_given"
    },
    {
      "fieldname": "currency",
      "label": "Currency",
      "fieldtype": "Link",
      "options": "Currency",
      "read_only_depends_on": "eval:doc.compensation_not_given"
    },
    {
      "fieldname": "compensation_period",
      "label": "Compensation Period",
      "fieldtype": "Select",
      "options": "\nYear\nMonth\nHour\nProject",
      "read_only_depends_on": "eval:doc.compensation_not_given"
    },
    {
      "fieldname": "posted_on",
      "label": "Posted On",
      "fieldtype": "Date"
    },
    {
      "fieldname": "job_details_section",
      "fieldtype": "Section Break",
      "label": "Job Details"
    },
    {
      "fieldname": "posting_digest",
      "label": "Job Description / Posting",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "research_heuristics_section",
      "fieldtype": "Section Break",
      "label": "Research Heuristics"
    },
    {
      "fieldname": "research_heuristics",
      "fieldtype": "Table",
      "label": "Research Heuristics",
      "options": "Job Search Heuristic Value",
      "description": "Provide a value for every heuristic defined in the active job search before moving to Ready to Review."
    },
    {
      "fieldname": "research_notes_section",
      "fieldtype": "Section Break",
      "label": "Research Notes",
      "collapsible": 1
    },
    {
      "fieldname": "research_digest",
      "label": "Research Findings & Sources",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "agent_recommendation",
      "label": "Agent Recommendation",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "application_review",
      "label": "Application Materials for Review",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "interview_brief",
      "label": "Interview Preparation",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "human_feedback",
      "label": "Human Feedback / Instructions",
      "fieldtype": "Text Editor"
    }
  ],
  "permissions": [
    {
      "role": "Job Search Operator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Job Search Approver",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "actions": [],
  "title_field": "job_title",
  "show_title_field_in_link": 1
}
