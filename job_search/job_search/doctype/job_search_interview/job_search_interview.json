    },
    {
      "fieldname": "round",
      "label": "Round",
      "fieldtype": "Int"
    },
    {
      "fieldname": "scheduled_at",
      "label": "Scheduled At",
      "fieldtype": "Datetime"
    },
    {
      "fieldname": "timezone",
      "label": "Timezone",
      "fieldtype": "Data"
    },
    {
      "fieldname": "interviewers",
      "label": "Interviewers",
      "fieldtype": "Table",
      "options": "Job Search Interview Contact"
    },
    {
      "fieldname": "preparation",
      "label": "Preparation",
      "fieldtype": "Link",
      "options": "Job Search Research"
    },
    {
      "fieldname": "notes",
      "label": "Notes",
